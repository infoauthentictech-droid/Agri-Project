<?xml version="1.0" encoding="utf-8"?>
<!-- Production network-security policy: TLS only.

     No cleartext traffic is permitted anywhere and debug/LAN development
     allowances live in the debug/profile source sets, NOT here. A release
     build therefore can never talk to an http:// backend. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
