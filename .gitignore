# =============================================================================
# Groundnut AI — .gitignore
# =============================================================================

# --- Flutter / Dart ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.build/
build/
android/app/build/
android/app/.gradle/
android/gradlew
android/gradlew.bat
android/local.properties
android/key.properties
android/key.jks
*.iml
.iws/
.metadata/
.web/

# --- Python / virtual environments ---
.venv/
.venv-gpu/
env/
env/
ENV/
env.bak/
venv/
.venv*/
.pytest_cache/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv.db
.ipynb_checkpoints/
.ropeproject/

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.devin/
.claude/

# --- Logs ---
*.log
*.err.log
backend_run.log
backend_run.err.log

# --- Data / model artifacts (large, regenerated by training pipelines) ---
datasets/
runs/
/experiments/**
!/experiments/**/
/weights/
# Ignore training checkpoints, but keep production inference weights at root:
*.pt
!/yolov8n.pt
!/yolov8n-seg.pt
*.joblib
*.pkl
*.onnx
*.h5
*.csv
*.json

# --- Docs / scratch outputs ---
*.md  # NOTE: remove this line if you want to track Markdown docs
classification_*/
dataset_*/
matching_preview*/
exception_preview*/
*.inventory.csv
*_inventory.csv
*_audit.csv

# --- Misc project files ---
nul
Questions and Answers/

# =============================================================================
# Keep these (explicitly un-ignore if needed):
# =============================================================================
!backend/
!lib/
!ml/
!herbicide/
!models/
!docs/
!deploy/
!pubspec.yaml
!pubspec.lock
!README.md
!requirements.txt
!run_server.py
!Dockerfile
!render.yaml
# =============================================================================
# Runtime artifacts the deployed backend needs (must stay AFTER the ignore
# rules above so these negations win). Keep in sync with /.dockerignore.
# =============================================================================
!/experiments/yolo/agri_yolov8n/weights/best.pt
!/experiments/yoloseg/agri_yolov8n_seg/weights/best.pt
!/experiments/by_dataset/hybrid/plant_gate/plant_gate_model.joblib
!/experiments/by_dataset/hybrid/plant_gate/plant_gate_model.json
!/experiments/classification/cnn/best_model.pth
!/experiments/classification/cnn/results.json
!/experiments/classification/mobilenet/best_model.pth
!/experiments/classification/mobilenet/results.json
!/experiments/classification/efficientnet/best_model.pth
!/experiments/classification/efficientnet/results.json
!/herbicide/processed/herbicide_dataset_normalized.json
!/ml/density/default_config.json
!/.dockerignore
