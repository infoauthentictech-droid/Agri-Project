# --- Flutter / Dart ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.build/
build/
android/app/build/
android/app/.gradle/
android/gradlew
android/gradlew.bat
android/local.properties
android/key.properties
android/key.jks
*.iml
.iws/
.metadata/
.web/

# --- Python / virtual environments ---
.venv/
.venv-gpu/
env/
env/
ENV/
env.bak/
venv/
.venv*/
.pytest_cache/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv.db
.ipynb_checkpoints/
.ropeproject/

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.devin/
.claude/

# --- Logs ---
*.log
*.err.log
backend_run.log
backend_run.err.log

# --- Data / model artifacts (large, regenerated by training pipelines) ---
datasets/
runs/
experiments/
weights/
# Ignore training checkpoints, but keep production inference weights at root:
*.pt
!/yolov8n.pt
!/yolov8n-seg.pt
*.joblib
*.pkl
*.onnx
*.h5
*.csv
*.json

# --- Docs / scratch outputs ---
*.md  # NOTE: remove this line if you want to track Markdown docs
classification_*/
dataset_*/
matching_preview*/
exception_preview*/
*.inventory.csv
*_inventory.csv
*_audit.csv

# --- Misc project files ---
nul
Questions and Answers/

# =============================================================================
# Keep these (explicitly un-ignore if needed):
# =============================================================================
!backend/
!lib/
!ml/
!herbicide/
!models/
!docs/
!deploy/
